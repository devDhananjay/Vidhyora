# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/vidyora?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-a-secure-random-string-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google Sign-In (OAuth 2.0 Web client — from Google Cloud / Firebase)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# RAZORPAY_KEY_ID is only needed if using Razorpay for payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# S3-compatible storage
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION="auto"
STORAGE_PUBLIC_URL=""

# Email (SMTP). Required to actually send welcome, offers, dropout and festival mail.
# Example: smtp://USER:PASSWORD@smtp.example.com:587
EMAIL_SERVER=""
EMAIL_FROM="VIDYORA <noreply@vidyora.co.in>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="VIDYORA"

# Firebase (client — Analytics)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Google Maps — Geocoding + Distance Matrix (server-side only)
GOOGLE_MAPS_API_KEY=""
GOOGLE_DELIVERY_ORIGIN_PIN="110001"

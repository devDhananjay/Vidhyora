# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/vidyora?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-a-secure-random-string-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google Sign-In (OAuth 2.0 Web client — from Google Cloud / Firebase)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# RAZORPAY — set webhook URL in Razorpay dashboard to:
#   https://YOUR_DOMAIN/api/payments/webhook
# Events: payment.captured, order.paid
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# S3-compatible storage (AWS S3 or Cloudflare R2). When empty, files save under public/uploads.
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION="auto"
STORAGE_PUBLIC_URL=""

# Email (SMTP). Required for welcome, order, ship, KYC and campaign mail.
# Example: smtp://USER:PASSWORD@smtp.example.com:587
EMAIL_SERVER=""
EMAIL_FROM="VIDYORA <noreply@vidyora.co.in>"

# Invoice / business (optional — used on tax invoices)
INVOICE_LEGAL_NAME="VIDYORA"
INVOICE_GSTIN=""
INVOICE_PAN=""
INVOICE_ADDRESS_LINE1=""
INVOICE_ADDRESS_LINE2=""
INVOICE_CITY=""
INVOICE_STATE="Uttar Pradesh"
INVOICE_POSTAL_CODE=""
INVOICE_ORIGIN_STATE="Uttar Pradesh"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="VIDYORA"

# Firebase (client — Analytics)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Google Maps — Geocoding + Distance Matrix (server-side only)
GOOGLE_MAPS_API_KEY=""
GOOGLE_DELIVERY_ORIGIN_PIN="110001"

# AI product assist (seller "Add with AI"). Set one provider.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# GEMINI_BLOG_API_KEY=""  # preferred (ContentVerse create-blog key)
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-flash-latest"
# AI_PROVIDER="gemini" # or "openai" — auto-detects from keys if unset
# Fallbacks try: gemini-flash-latest → gemini-3.6-flash → gemini-3.5-flash-lite → …

# Shiprocket (optional — live AWB tracking when seller uses Shiprocket)
# SHIPROCKET_EMAIL=""
# SHIPROCKET_PASSWORD=""

# Cron jobs (Bearer token for /api/cron/*)
# Example: curl -H "Authorization: Bearer $CRON_SECRET" https://vidyora.co.in/api/cron/price-drop-alerts
CRON_SECRET=""

# SMS / Phone OTP (optional — MSG91 or Twilio). Without these, OTP works in
# non-production via console logs, or set SMS_CONSOLE=1 / OTP_DEV_BYPASS=1.
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="VIDYORA"
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# SMS_CONSOLE="1"
# OTP_DEV_BYPASS="1"

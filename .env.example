# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/vidyora?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-a-secure-random-string-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# RAZORPAY_KEY_ID is only needed if using Razorpay for payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# For frontend Razorpay integration
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# S3-compatible storage
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION="auto"
STORAGE_PUBLIC_URL=""

# Email (Resend / SMTP)
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="VIDYORA <noreply@vidyora.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="VIDYORA"
